# Copy to .env and fill in. Real environment variables always win over this file.

# Hugging Face token with the "Make calls to Inference Providers" permission
# https://huggingface.co/settings/tokens/new?tokenType=fineGrained
# The same token is used for answers (chat model) and for embeddings (semantic search).
HF_TOKEN=hf_your_token_here

# What the bot knows: files, folders and URLs, separated by commas (or ; if a path has commas)
CITEDESK_SOURCES=samples/loopline
CITEDESK_COMPANY=Loopline E-Bikes

# Optional overrides
# CITEDESK_MODEL=google/gemma-4-31B-it
# CITEDESK_EMBED_MODEL=BAAI/bge-m3
# CITEDESK_TOP_K=6
# CITEDESK_MIN_SIMILARITY=0.45        # below this nothing counts as related -> hand off to a human

# Server
# CITEDESK_ADMIN_KEY=change-me         # protects POST /reindex (without it, only localhost may re-index)
# CITEDESK_HANDOFF_WEBHOOK=http://localhost:5678/webhook/citedesk-handoff
# CITEDESK_WEBHOOK_SECRET=change-me-too
# CITEDESK_CORS_ORIGINS=https://www.your-shop.com
# CITEDESK_RATE_LIMIT=20               # questions per minute per visitor
# CITEDESK_LOG_PATH=logs/conversations.jsonl   # empty = don't log questions

# Fully local & private with Ollama (no key needed):
# CITEDESK_BASE_URL=http://localhost:11434/v1
# CITEDESK_MODEL=qwen3:8b
# CITEDESK_REASONING_EFFORT=none
# CITEDESK_EMBED_BASE_URL=http://localhost:11434/v1
# CITEDESK_EMBED_MODEL=bge-m3

# DeepSeek (cheap; it has no embeddings API, so pair it with Ollama or HF embeddings):
# CITEDESK_BASE_URL=https://api.deepseek.com
# CITEDESK_API_KEY=sk-...
# CITEDESK_MODEL=deepseek-flash
# CITEDESK_EXTRA_BODY={"thinking": {"type": "disabled"}}
# CITEDESK_JSON_MODE=object          # DeepSeek has JSON mode but not JSON schemas; skips one rejected request
# CITEDESK_EMBED_BASE_URL=http://localhost:11434/v1
# CITEDESK_EMBED_MODEL=bge-m3

# OpenAI, Groq, OpenRouter... (any OpenAI-compatible API):
# CITEDESK_BASE_URL=https://api.openai.com/v1
# CITEDESK_API_KEY=sk-...
# CITEDESK_MODEL=<model id>
